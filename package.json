{
  "name": "agent-aisle",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check . && npm run skills:check && npm run lint:skills",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "registry:build": "tsx registry/build.ts",
    "registry:validate": "tsx registry/validate-pr.ts",
    "skills:build": "tsx registry/compile-skills.ts",
    "skills:check": "tsx registry/compile-skills.ts --check",
    "lint:skills": "tsx registry/run-lint-skills.ts",
    "registry:validate-elsewhere": "tsx registry/validate-elsewhere.ts",
    "registry:audit-pr": "tsx registry/audit-pr.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
