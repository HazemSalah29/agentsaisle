{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "arch-visualize model",
  "type": "object",
  "required": ["version", "project", "nodes", "edges", "flows", "risks"],
  "properties": {
    "version": {
      "enum": [1, 2, 3]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "candidates": {
      "type": "array",
      "description": "Connections the draft only suspects. Confirm each as an edge or delete it.",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "views": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "inferred": {
      "type": "array",
      "description": "Items without evidence, as node:<id> or edge:<id>.",
      "items": {
        "type": "string",
        "pattern": "^(node|edge):[a-z0-9][a-z0-9-]*$"
      }
    }
  },
  "$defs": {
    "zone": {
      "enum": ["public", "dmz", "private", "third-party", "user-device"]
    },
    "dataLabel": {
      "enum": ["pii", "credentials", "payments", "health", "secrets-ref", "logs"]
    },
    "lens": {
      "enum": ["system", "flows", "security", "failure", "ai", "diff"]
    },
    "unknownOr": {
      "enum": ["unknown"]
    },
    "candidate": {
      "type": "object",
      "required": ["id", "from", "to", "confidence", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "maxLength": 60
        },
        "sync": {
          "type": "boolean"
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "why": {
          "type": "string",
          "maxLength": 160
        },
        "confirms": {
          "$ref": "#/$defs/id"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "optional": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": ["deploy", "namespace", "package", "other"]
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "name", "lens"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "focus": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "role": {
      "enum": [
        "client",
        "edge",
        "frontend",
        "backend",
        "worker",
        "queue",
        "cache",
        "database",
        "storage",
        "search",
        "auth",
        "external",
        "observability"
      ]
    },
    "tier": {
      "enum": ["clients", "edge", "frontend", "backend", "async", "data", "external"]
    },
    "evidence": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "role", "tech", "tier"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "tech": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "zone": {
          "$ref": "#/$defs/zone"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLabel"
          }
        },
        "replicas": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/unknownOr"
            }
          ]
        },
        "ai": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["llm-provider", "agent", "mcp-server", "skill", "vector-store"]
            },
            "auditGrade": {
              "enum": ["A", "B", "C", "D", "F"]
            },
            "auditSource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "tools": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "owner": {
          "type": "string",
          "maxLength": 80
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "detail": {
          "$ref": "#/$defs/detail"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string"
        },
        "sync": {
          "type": "boolean"
        },
        "auth": {
          "enum": ["none", "session", "jwt", "api-key", "mtls", "oauth", "unknown"]
        },
        "tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/unknownOr"
            }
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "carries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLabel"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "via": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["from", "to", "kind"],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kind": {
                "enum": ["call", "render", "fetch", "rpc"]
              },
              "label": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "properties": {
        "edge": {
          "$ref": "#/$defs/id"
        },
        "reverse": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "together": {
          "type": "boolean"
        },
        "event": {
          "type": "string",
          "maxLength": 40
        },
        "node": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowStep"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["id", "severity", "nodes", "why", "check"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "severity": {
          "enum": ["info", "warn"]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "why": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "source": {
          "enum": ["rule", "agent"]
        },
        "fixes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "tradeoff": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "symbolRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "symbol": {
      "type": "object",
      "required": ["id", "name", "kind", "file", "line"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": ["function", "component", "hook", "method", "route", "procedure"]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "exported": {
          "type": "boolean"
        },
        "async": {
          "type": "boolean"
        },
        "doc": {
          "type": "string",
          "maxLength": 160
        },
        "docBy": {
          "enum": ["comment", "agent"]
        },
        "route": {
          "type": "object",
          "required": ["path", "method"],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 200
            },
            "method": {
              "type": "string",
              "maxLength": 10
            }
          }
        },
        "procedure": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["query", "mutation", "subscription"]
            },
            "path": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "calls": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": ["to", "name", "line"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "in": {
                "enum": ["loop", "branch", null]
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "renders": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": ["name", "line"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "in": {
                "enum": ["loop", "branch", null]
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "module": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "external": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "in": {
                "enum": ["loop", "branch", null]
              },
              "module": {
                "type": "string",
                "maxLength": 200
              },
              "outside": {
                "type": "boolean"
              }
            }
          }
        },
        "fetches": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["url", "method", "line"],
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 200
              },
              "method": {
                "type": "string",
                "maxLength": 10
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "in": {
                "enum": ["loop", "branch", null]
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "rpc": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["path", "kind", "line"],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 200
              },
              "kind": {
                "enum": ["query", "mutation"]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "in": {
                "enum": ["loop", "branch", null]
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "inferred": {
                "type": "boolean"
              }
            }
          }
        },
        "calledBy": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "loops": {
          "type": "integer",
          "minimum": 0
        },
        "branches": {
          "type": "integer",
          "minimum": 0
        },
        "hiddenCalls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detail": {
      "type": "object",
      "required": ["scope", "symbols"],
      "properties": {
        "scope": {
          "type": "string",
          "maxLength": 300
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "parsed": {
          "type": "integer",
          "minimum": 0
        },
        "symbolsFound": {
          "type": "integer",
          "minimum": 0
        },
        "symbolsKept": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "focus": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "depth": {
              "type": "integer",
              "minimum": 1
            },
            "reached": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "symbols": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      }
    }
  }
}
