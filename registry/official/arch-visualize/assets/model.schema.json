{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "arch-visualize model",
  "type": "object",
  "required": ["version", "project", "nodes", "edges", "flows", "risks"],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "views": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "inferred": {
      "type": "array",
      "description": "Items without evidence, as node:<id> or edge:<id>.",
      "items": {
        "type": "string",
        "pattern": "^(node|edge):[a-z0-9][a-z0-9-]*$"
      }
    }
  },
  "$defs": {
    "zone": {
      "enum": ["public", "dmz", "private", "third-party", "user-device"]
    },
    "dataLabel": {
      "enum": ["pii", "credentials", "payments", "health", "secrets-ref", "logs"]
    },
    "lens": {
      "enum": ["system", "flows", "security", "failure", "ai", "diff"]
    },
    "unknownOr": {
      "enum": ["unknown"]
    },
    "group": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": ["deploy", "namespace", "package", "other"]
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "name", "lens"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "focus": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number" }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "role": {
      "enum": [
        "client",
        "edge",
        "frontend",
        "backend",
        "worker",
        "queue",
        "cache",
        "database",
        "storage",
        "search",
        "auth",
        "external",
        "observability"
      ]
    },
    "tier": {
      "enum": ["clients", "edge", "frontend", "backend", "async", "data", "external"]
    },
    "evidence": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "role", "tech", "tier"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "tech": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "zone": {
          "$ref": "#/$defs/zone"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLabel"
          }
        },
        "replicas": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/unknownOr" }]
        },
        "ai": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["llm-provider", "agent", "mcp-server", "skill", "vector-store"]
            },
            "auditGrade": {
              "enum": ["A", "B", "C", "D", "F"]
            },
            "auditSource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "owner": {
          "type": "string",
          "maxLength": 80
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string"
        },
        "sync": {
          "type": "boolean"
        },
        "auth": {
          "enum": ["none", "session", "jwt", "api-key", "mtls", "oauth", "unknown"]
        },
        "tls": {
          "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/unknownOr" }]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "carries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLabel"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "properties": {
        "edge": {
          "$ref": "#/$defs/id"
        },
        "reverse": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "together": {
          "type": "boolean"
        },
        "event": {
          "type": "string",
          "maxLength": 40
        },
        "node": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowStep"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["id", "severity", "nodes", "why", "check"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "severity": {
          "enum": ["info", "warn"]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "why": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "source": {
          "enum": ["rule", "agent"]
        }
      }
    }
  }
}
