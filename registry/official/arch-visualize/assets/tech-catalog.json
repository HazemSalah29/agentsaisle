  "envKeys": [
    {
      "pattern": "^DATABASE_URL$",
      "tech": "database",
      "role": "database",
      "note": "env key DATABASE_URL"
    },
    {
      "pattern": "^(REDIS|CACHE)_URL$",
      "tech": "redis",
      "role": "cache",
      "note": "env key REDIS_URL"
    },
    {
      "pattern": "^STRIPE_",
      "tech": "stripe",
      "role": "external",
      "note": "env key STRIPE_*"
    },
    {
      "pattern": "^(S3_|AWS_S3_)",
      "tech": "aws-s3",
      "role": "storage",
      "note": "env key S3_*"
    },
    {
      "pattern": "^(RESEND_|SENDGRID_)",
      "tech": "email",
      "role": "external",
      "note": "email provider key"
    },
    {
      "pattern": "^(RABBITMQ|AMQP)_URL$",
      "tech": "rabbitmq",
      "role": "queue",
      "note": "env key RABBITMQ_URL"
    },
    {
      "pattern": "^ANTHROPIC_",
      "tech": "anthropic",
      "role": "external",
      "note": "env key ANTHROPIC_*"
    },
    {
      "pattern": "^OPENAI_",
      "tech": "openai",
      "role": "external",
      "note": "env key OPENAI_*"
    },
    {
      "pattern": "^(GEMINI|GOOGLE_GENERATIVE_AI)_",
      "tech": "gemini",
      "role": "external",
      "note": "env key GEMINI_*"
    },
    {
      "pattern": "^GITHUB_",
      "tech": "github",
      "role": "external",
      "note": "env key GITHUB_*"
    },
    {
      "pattern": "^SUPABASE_",
      "tech": "supabase",
      "role": "database",
      "note": "env key SUPABASE_*"
    },
    {
      "pattern": "^MONGO(DB)?_(URI|URL)$",
      "tech": "mongodb",
      "role": "database",
      "note": "env key MONGODB_URI"
    },
    {
      "pattern": "^(POSTGRES|PG)_(URL|URI)$|^POSTGRES_PRISMA_URL$",
      "tech": "postgresql",
      "role": "database",
      "note": "env key POSTGRES_URL"
    },
    {
      "pattern": "^SENTRY_",
      "tech": "sentry",
      "role": "observability",
      "note": "env key SENTRY_*"
    },
    {
      "pattern": "^SMTP_",
      "tech": "smtp",
      "role": "external",
      "note": "env key SMTP_*"
    }
  ],
