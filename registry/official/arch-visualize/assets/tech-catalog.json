    { "pattern": "^STRIPE_", "tech": "stripe", "role": "external", "note": "env key STRIPE_*" },
    { "pattern": "^(S3_|AWS_S3_)", "tech": "aws-s3", "role": "storage", "note": "env key S3_*" },
    { "pattern": "^(RESEND_|SENDGRID_)", "tech": "email", "role": "external", "note": "email provider key" },
    { "pattern": "^(RABBITMQ|AMQP)_URL$", "tech": "rabbitmq", "role": "queue", "note": "env key RABBITMQ_URL" }
  ],
