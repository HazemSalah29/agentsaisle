      "why": "One PostgreSQL service and no replica or backup configuration in the files read.",
      "check": "Confirm backups and a restore path exist outside this repository, and decide whether a replica is needed.",
      "source": "agent"
    },
    {
      "id": "agent-session-no-expiry",
      "severity": "info",
      "nodes": ["cache", "api"],
      "evidence": [
        {
          "file": "apps/api/src/lib/session.ts",
          "line": 10,
          "note": "redis.set without EX"
        }
      ],
      "why": "Sessions are written to Redis without an expiry, so they stay until evicted.",
      "check": "Check the Redis eviction policy, or add a TTL when saving a session.",
      "source": "agent"
    }
