      "id": "AV-R01",
      "title": "Single database with no replica or backup configuration",
      "severity": "warn",
      "nodes": ["mongo"],
      "evidence": [
        {
          "file": "docker-compose.yml",
          "line": 3,
          "note": "image mongo:7, ports 27017:27017"
        },
        {
          "file": "package.json",
          "line": 30,
          "note": "dependency mongoose"
        }
      ],
      "why": "The model has one database and none of the files read mention a replica, a standby, a backup tool or a managed database service.",
      "check": "Confirm where backups are taken and that a restore has been tried. Decide whether a replica or a managed service is worth its cost for this project.",
      "source": "rule"
    },
    {
      "id": "AV-R08",
      "title": "No health check endpoint found",
      "severity": "info",
      "nodes": ["properlearn"],
      "evidence": [
        {
          "file": "package.json",
          "line": 31,
          "note": "dependency next"
        }
      ],
      "why": "Heuristic: the app defines routes but none of the files read has a /health, /healthz or /ready route.",
      "check": "Check whether your host, load balancer or orchestrator probes the service another way (a TCP check, the home page). If not, a small health route lets it restart or stop sending traffic to a stuck instance.",
      "source": "rule"
    },
    {
      "id": "AV-R10",
      "title": "Data service exposed or unprotected in docker-compose",
      "severity": "warn",
      "nodes": ["mongo", "redis"],
      "evidence": [
        {
          "file": "docker-compose.yml",
          "line": 4,
          "note": "mongo: port 27017:27017 published on all interfaces"
        },
        {
          "file": "docker-compose.yml",
          "line": 11,
          "note": "redis: port 6379:6379 published on all interfaces"
        },
        {
          "file": "docker-compose.yml",
          "line": 10,
          "note": "redis: Redis has no requirepass or REDIS_PASSWORD"
        }
      ],
      "why": "A compose service for a data store publishes its port to the host on all interfaces, or Redis has no password (requirepass) configured.",
      "check": "Check where this compose file is used. For local development it is often fine; on a shared or public machine, bind ports to 127.0.0.1, set a password and keep the service off public networks.",
      "source": "rule"
    },
    {
      "id": "agent-docker-socket",
      "title": "The app container can control the host Docker engine",
      "severity": "warn",
      "nodes": ["properlearn", "docker"],
      "evidence": [
        {
          "file": "docker-compose.yml",
          "line": 70,
          "note": "/var/run/docker.sock mounted into the app"
        }
      ],
      "why": "The app container gets the host Docker socket, so a bug or compromise in the app could start or inspect any container on that host.",
      "check": "Check whether this compose file is used outside local development. Consider a socket proxy that allows only the calls the labs need, or a separate sandbox host.",
      "source": "agent"
    }
