{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video.json",
  "type": "object",
  "required": ["version", "meta", "scenes"],
  "properties": {
    "version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": ["title", "type", "format", "fps", "lang"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": ["explainer", "kinetic", "showcase"]
        },
        "format": {
          "enum": ["reel-9x16", "short-9x16", "youtube-16x9", "square-1x1"]
        },
        "fps": {
          "enum": [24, 25, 30, 60]
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
        },
        "dir": {
          "enum": ["ltr", "rtl"]
        },
        "audience": {
          "type": "string",
          "maxLength": 80
        },
        "brand": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "script": {
      "type": "string",
      "maxLength": 200
    },
    "voice": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "enum": ["kokoro", "3arab", "recorded", "test", "none"]
        },
        "voiceId": {
          "type": "string",
          "maxLength": 80
        },
        "speed": {
          "type": "number",
          "minimum": 0.5
        }
      }
    },
    "sfx": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["file", "at"],
        "properties": {
          "file": {
            "type": "string",
            "maxLength": 200
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "gainDb": {
            "type": "number",
            "minimum": -30,
            "maximum": 6
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["asset"],
      "properties": {
        "asset": {
          "type": "string",
          "maxLength": 200
        },
        "duckUnderVoiceDb": {
          "type": "number"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "burn": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "realisticSynthetic": {
          "type": "boolean"
        },
        "aiMusic": {
          "type": "boolean"
        },
        "voiceClone": {
          "enum": ["none", "self", "consented"]
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": ["volt", "ember", "ice", "grape"]
        },
        "captions": {
          "enum": ["pop", "karaoke", "clean", "none"]
        },
        "music": {
          "enum": ["pulse", "none"]
        },
        "bpm": {
          "type": "integer",
          "minimum": 70,
          "maximum": 150
        },
        "sfx": {
          "type": "boolean"
        },
        "progress": {
          "type": "boolean"
        },
        "grain": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "kind": {
          "enum": [
            "title",
            "list",
            "number",
            "versus",
            "steps",
            "code",
            "terminal",
            "chart",
            "nodes",
            "request-flow",
            "rate-limit",
            "sequence",
            "quote",
            "broll",
            "kinetic",
            "screen"
          ]
        },
        "durationFrom": {
          "enum": ["voice", "fixed"]
        },
        "seconds": {
          "type": "number",
          "minimum": 0.5
        },
        "narration": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "props": {
          "type": "object",
          "description": "Checked per kind by assets/film/rules.mjs."
        },
        "transitionIn": {
          "enum": ["cut", "fade", "slide", "whip", "zoom-through", "slash", "shatter"]
        },
        "narrationAt": {
          "type": "object",
          "description": "Seconds into a fixed scene where each narration line starts (screen recordings)."
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "path", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": ["image", "video", "audio", "font", "other"]
        },
        "source": {
          "enum": ["generated", "user", "download", "library"]
        },
        "licence": {
          "type": "string",
          "maxLength": 80
        },
        "attribution": {
          "type": "string",
          "maxLength": 300
        },
        "aiGenerated": {
          "type": "boolean"
        },
        "realistic": {
          "type": "boolean"
        },
        "voiceClone": {
          "enum": ["none", "self", "consented"]
        }
      }
    }
  }
}
