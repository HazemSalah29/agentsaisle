{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video.json",
  "type": "object",
  "required": ["version", "meta", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "type", "format", "fps", "lang"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "enum": ["explainer", "kids", "story", "showcase", "edit", "custom"] },
        "format": { "enum": ["reel-9x16", "short-9x16", "youtube-16x9", "square-1x1"] },
        "fps": { "enum": [24, 25, 30, 60] },
        "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$" },
        "dir": { "enum": ["ltr", "rtl"] },
        "audience": { "type": "string", "maxLength": 80 },
        "brand": { "type": "string", "maxLength": 200 }
      }
    },
    "script": { "type": "string", "maxLength": 200 },
    "voice": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["kokoro", "chatterbox", "3arab", "elevenlabs", "test", "none"] },
        "voiceId": { "type": "string", "maxLength": 80 },
        "speed": { "type": "number", "minimum": 0.5 }
      }
    },
    "music": {
      "type": "object",
      "required": ["asset"],
      "properties": {
        "asset": { "type": "string", "maxLength": 200 },
        "duckUnderVoiceDb": { "type": "number" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/scene" }
    },
    "captions": {
      "type": "object",
      "properties": {
        "style": { "enum": ["karaoke", "pop", "clean", "cinematic", "kids"] },
        "maxWordsPerLine": { "type": "integer", "minimum": 1 },
        "safeZone": { "enum": ["reel", "short", "youtube", "none"] },
        "burn": { "type": "boolean" }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/definitions/asset" }
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "realisticSynthetic": { "type": "boolean" },
        "aiMusic": { "type": "boolean" },
        "voiceClone": { "enum": ["none", "self", "consented"] }
      }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "kind": {
          "enum": [
            "title",
            "quote",
            "list",
            "chart",
            "broll",
            "rate-limit",
            "code",
            "sequence",
            "request-flow",
            "screen",
            "custom"
          ]
        },
        "durationFrom": { "enum": ["voice", "fixed"] },
        "seconds": { "type": "number", "minimum": 0.5 },
        "narration": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
        },
        "props": { "type": "object" },
        "transitionIn": { "enum": ["cut", "fade", "slide", "zoom", "whip", "match"] },
        "captions": { "enum": ["auto", "off", "custom"] }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "path", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["image", "video", "audio", "font", "other"] },
        "source": { "enum": ["generated", "user", "download", "library"] },
        "licence": { "type": "string", "maxLength": 80 },
        "attribution": { "type": "string", "maxLength": 300 },
        "aiGenerated": { "type": "boolean" },
        "realistic": { "type": "boolean" },
        "voiceClone": { "enum": ["none", "self", "consented"] }
      }
    },
    "props": {
      "title": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 120 },
          "subtitle": { "type": "string", "maxLength": 200 }
        }
      },
      "quote": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 300 },
          "by": { "type": "string", "maxLength": 80 },
          "source": { "type": "string", "maxLength": 200 }
        }
      },
      "list": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "heading": { "type": "string", "maxLength": 120 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "numbered": { "type": "boolean" }
        }
      },
      "chart": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": { "enum": ["bar", "line"] },
          "title": { "type": "string", "maxLength": 120 },
          "unit": { "type": "string", "maxLength": 20 },
          "data": {
            "type": "array",
            "minItems": 2,
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "value": { "type": "number" }
              }
            }
          }
        }
      },
      "broll": {
        "type": "object",
        "required": ["asset"],
        "properties": {
          "asset": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "fit": { "enum": ["cover", "contain"] },
          "caption": { "type": "string", "maxLength": 160 }
        }
      },
      "rate-limit": {
        "type": "object",
        "required": ["seed", "count", "pattern", "algos"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "seed": { "type": "integer", "minimum": 0 },
          "count": { "type": "integer", "minimum": 1 },
          "pattern": { "type": "object", "required": ["type", "ratePerSec"] },
          "algos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "object", "required": ["algo"] }
          }
        }
      },
      "code": {
        "type": "object",
        "required": ["language"],
        "properties": {
          "language": { "type": "string" },
          "title": { "type": "string", "maxLength": 120 },
          "file": { "type": "string", "maxLength": 80 },
          "code": { "type": "string", "maxLength": 1500 },
          "diff": { "type": "object", "required": ["before", "after"] },
          "focus": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "object", "required": ["lines"] }
          }
        }
      },
      "sequence": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "title": { "type": "string", "maxLength": 120 }
        }
      },
      "screen": {
        "type": "object",
        "required": ["asset"],
        "properties": {
          "asset": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "pip": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "device": { "enum": ["phone", "laptop", "browser", "none"] },
          "title": { "type": "string", "maxLength": 120 },
          "viewport": { "type": "object", "required": ["w", "h"] },
          "zoom": { "type": "array", "maxItems": 40, "items": { "type": "object" } },
          "cursor": { "type": "array", "maxItems": 600, "items": { "type": "object" } },
          "ripples": { "type": "array", "maxItems": 60, "items": { "type": "object" } }
        }
      },
      "request-flow": {
        "type": "object",
        "required": ["nodes", "edges", "steps"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": { "type": "object", "required": ["id", "label", "tier"] }
          },
          "edges": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "object", "required": ["id", "from", "to"] }
          },
          "steps": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "type": "object" } }
        }
      },
      "custom": { "type": "object" }
    }
  }
}
