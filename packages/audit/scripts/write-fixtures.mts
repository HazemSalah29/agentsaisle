// Writes the static malicious fixtures (test/cases.ts) to fixtures/malicious/<id>/.
// Run: pnpm exec tsx scripts/write-fixtures.mts   (from packages/audit)
import { mkdirSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { MALICIOUS } from "../test/cases.ts";

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "fixtures", "malicious");
rmSync(root, { recursive: true, force: true });
for (const c of MALICIOUS) {
  if (c.runtime) continue;
  const dir = path.join(root, c.id);
  for (const [rel, spec] of Object.entries(c.files)) {
    if (typeof spec !== "string") continue;
    const file = path.join(dir, rel);
    mkdirSync(path.dirname(file), { recursive: true });
    writeFileSync(file, spec);
  }
  writeFileSync(
    path.join(dir, "README.md"),
    `# ${c.id} (test data)\n\nInert sample that must trigger \`${c.rule}\`. It exists only to test \`aisle audit\`; do not install it. Generated by scripts/write-fixtures.mts.\n`,
  );
}
console.log("fixtures written");
