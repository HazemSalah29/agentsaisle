{
  "name": "@agentsaisle/cli",
  "version": "0.2.0",
  "description": "Install Agent Skills into your project with one command.",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "skills",
    "cli",
    "ai-agents"
  ],
  "homepage": "https://agentsaisle-vercel.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HazemSalah29/agentsaisle.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/HazemSalah29/agentsaisle/issues"
  },
  "type": "module",
  "bin": {
    "aisle": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agentsaisle/audit": "workspace:*",
    "@agentsaisle/registry-schema": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
