{
  "version": 1,
  "meta": {
    "title": "How a rate limiter saves your API",
    "type": "explainer",
    "format": "reel-9x16",
    "fps": 30,
    "lang": "en"
  },
  "script": "script.md",
  "voice": {
    "provider": "kokoro",
    "voiceId": "am_michael",
    "speed": 1.1
  },
  "style": {
    "preset": "volt",
    "captions": "pop"
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "title",
      "narration": [
        "l1"
      ],
      "props": {
        "kicker": "System design",
        "text": "*10,000* requests. One second."
      }
    },
    {
      "id": "stakes",
      "kind": "kinetic",
      "narration": [
        "l2"
      ],
      "props": {
        "emph": [
          "falls",
          "over."
        ]
      },
      "transitionIn": "whip"
    },
    {
      "id": "ways",
      "kind": "list",
      "narration": [
        "l3",
        "l4"
      ],
      "props": {
        "heading": "Three ways to limit",
        "items": [
          {
            "text": "Token *bucket*",
            "on": "token"
          },
          {
            "text": "Fixed *window*",
            "on": "fixed"
          },
          {
            "text": "Sliding *window*",
            "on": "sliding"
          }
        ]
      },
      "transitionIn": "slide"
    },
    {
      "id": "code",
      "kind": "code",
      "narration": [
        "l5",
        "l6"
      ],
      "props": {
        "title": "Token bucket",
        "file": "limiter.ts",
        "language": "ts",
        "code": "function allow(b: Bucket): boolean {\n  refill(b);\n  if (b.tokens < 1) return false; // 429\n  b.tokens -= 1;\n  return true;\n}",
        "focus": [
          {
            "lines": [
              4,
              4
            ],
            "on": "spends"
          },
          {
            "lines": [
              2,
              2
            ],
            "on": "refill"
          },
          {
            "lines": [
              3,
              3
            ],
            "on": "run"
          }
        ]
      },
      "transitionIn": "zoom-through"
    },
    {
      "id": "proof",
      "kind": "rate-limit",
      "narration": [
        "l7"
      ],
      "props": {
        "title": "Same burst, two limiters",
        "seed": 7,
        "count": 60,
        "pattern": {
          "type": "burst",
          "ratePerSec": 12,
          "burstSize": 14,
          "burstEverySec": 1.5
        },
        "algos": [
          {
            "algo": "token-bucket",
            "capacity": 10,
            "refillPerSec": 6
          },
          {
            "algo": "fixed-window",
            "limit": 10,
            "windowSec": 1
          }
        ]
      },
      "transitionIn": "slash"
    },
    {
      "id": "verdict",
      "kind": "kinetic",
      "narration": [
        "l8"
      ],
      "props": {
        "bg": "accent",
        "phrases": [
          "So, bursty traffic?",
          "Use a token bucket."
        ]
      },
      "transitionIn": "shatter"
    },
    {
      "id": "cta",
      "kind": "title",
      "narration": [
        "l9"
      ],
      "props": {
        "kicker": "Part 2",
        "text": "Build it in *Redis*",
        "subtitle": "Follow so you don't miss it."
      },
      "transitionIn": "whip"
    }
  ]
}
